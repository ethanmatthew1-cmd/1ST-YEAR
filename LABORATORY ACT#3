#TASK 10: PERSONAL INFORMATION PROGRAM 

name = "Ethan Matthew R. Jaminal" 

age = 18

height = 1.69

siblings = 1

 

favorite_foods = ["Pizza", "Burger", "Chicken"] 

favorite_subjects = ("Python", "Database", "Networking") 

 

grade1 = 85 

grade2 = 90 

grade3 = 88 

 

numbers = range(1, 6) 

 

student = { 

 "name": "Ethan Matthew Jaminal", 

 "age": 17, 

 "course": "BSIT", 

 "section": "105" 
} 

 

# Arithmetic Calculations 

 

future_age = age + 5 

height_cm = height * 100 

total_grade = grade1 + grade2 + grade3 

average_grade = total_grade / 3 

 

# Display Information 

 

print("===== PERSONAL INFORMATION =====") 

print("Name:", name) 

print("Age:", age) 

print("Height:", height, "meters") 

print("Siblings:", siblings) 

 

