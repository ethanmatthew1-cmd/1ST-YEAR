print(student) 

 

print("\n===== CALCULATIONS =====") 

print("Age after 5 years:", future_age) 

print("Height in centimeters:", height_cm) 

print("Total Grade:", total_grade) 

print("Average Grade:", round(average_grade, 2)) 

 

print("\n===== DATA TYPES =====") 

